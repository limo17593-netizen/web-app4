{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app4",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0d6290e0-46e6-4fe5-be81-db6420f9e42f","database_name": "web-app5" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "086976f5753b4ef58c02b359f0064bce" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
